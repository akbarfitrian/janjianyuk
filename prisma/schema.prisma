generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Supabase Auth — Google OAuth)
//
// Kredensial & sesi login dikelola sepenuhnya oleh Supabase Auth (tabel
// auth.users bawaannya, di luar schema Prisma ini) — nggak ada lagi
// Account/Session/VerificationToken di sini, dan nggak ada password
// tersimpan di database aplikasi.
//
// User di bawah ini cuma nyimpen data BISNIS (role, outletId), key-nya
// (`id`) sengaja disamain persis dengan id user di Supabase Auth (uuid),
// bukan cuid buatan Prisma sendiri — lihat app/auth/callback dan
// app/api/onboarding yang nulis baris ini pertama kali.
//
// Outlet adalah tenant (klinik/salon). Owner yang login Google pertama kali
// diarahkan ke /onboarding buat bikin Outlet + User (role "owner") yang
// saling terhubung lewat outletId. Login staff individual (role "staff")
// menyusul di fase berikutnya kalau dibutuhkan — untuk sekarang cukup satu
// akun owner per outlet.
// ---------------------------------------------------------------------------

model User {
  id    String  @id // uuid, sama dengan auth.users.id di Supabase
  name  String?
  email String  @unique
  image String?
  role  String  @default("owner") // owner, staff — role bisnis

  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  createdAt DateTime @default(now())

  @@index([outletId])
}

// ---------------------------------------------------------------------------
// Domain inti — sesuai draft schema, multi-tenant lewat outletId di tiap
// tabel utama supaya satu database bisa melayani banyak klinik/salon.
// ---------------------------------------------------------------------------

model Outlet {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique // dipakai di /booking/[slug]
  ownerName   String
  ownerEmail  String    @unique
  ownerPhone  String
  planStatus  String    @default("trial") // trial, active, past_due, cancelled
  planName    String    @default("free") // free, pro
  trialEndsAt DateTime?

  // Jam operasional, diatur sendiri per outlet (lihat lib/business-hours.ts
  // + lib/availability.ts buat cara pakainya). Disimpan sebagai "HH:mm"
  // (WIB) biar gampang dicocokin ke <input type="time"> di form settings.
  // breakStartTime/breakEndTime null = outlet itu nggak ambil jam istirahat;
  // kalau diisi, dua-duanya wajib keisi bareng (divalidasi di
  // lib/business-hours.ts#validateBusinessHours, bukan di level schema).
  openTime       String  @default("09:00")
  closeTime      String  @default("18:00")
  breakStartTime String?
  breakEndTime   String?

  // Hari tutup mingguan, pakai nomor hari kalender WIB: 0 = Minggu … 6 = Sabtu
  // (mis. [5] = tutup tiap Jumat). Tanggal libur khusus (Lebaran, dst) ada di
  // OutletClosure. Lihat lib/schedule.ts.
  closedWeekdays Int[] @default([])

  createdAt DateTime @default(now())

  users         User[]
  staff         Staff[]
  customers     Customer[]
  services      Service[]
  bookings      Booking[]
  subscriptions Subscription[]
  closures      OutletClosure[]
}

// Jejak singkat booking publik per outlet & IP (sudah di-hash), dipakai cuma
// buat batasin spam — lihat lib/booking-abuse.ts. Baris lama dibersihkan
// otomatis, jadi tabel ini nggak numpuk.
model PublicBookingEvent {
  id        String   @id @default(cuid())
  outletId  String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([outletId, ipHash, createdAt])
}

// Outlet libur di tanggal tertentu (tanggal merah, Lebaran, renovasi, dll).
// date = "YYYY-MM-DD" kalender WIB, disimpan sebagai string biar nggak kena
// urusan timezone — sama kayak jam operasional yang disimpan "HH:mm".
model OutletClosure {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  date      String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([outletId, date])
}

model Staff {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  name      String
  email     String
  role      String   @default("staff") // owner, admin, staff
  phone     String?
  createdAt DateTime @default(now())

  bookings Booking[]
  timeOffs StaffTimeOff[]

  @@index([outletId])
}

// Staff cuti / nggak masuk di tanggal tertentu — di tanggal itu dia nggak
// ditawarkan di halaman booking publik. date = "YYYY-MM-DD" kalender WIB.
model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([staffId, date])
}

model Customer {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  name      String
  phone     String // format simpan 628xxxxxxxxxx — normalisasi di lib/phone.ts
  notes     String? // alergi, preferensi, catatan treatment
  createdAt DateTime @default(now())

  bookings         Booking[]
  customerPackages CustomerPackage[]

  // Satu no. HP = satu pelanggan per outlet, biar booking publik yang nyari
  // pelanggan lama lewat no. HP nggak bikin dobel & riwayat nggak terpecah.
  @@unique([outletId, phone])
  @@index([outletId])
}

model Service {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  name        String
  category    String? // pengelompokan di daftar admin & halaman booking publik (mis. "Potong", "Warna")
  description String? // keterangan singkat isi layanan, tampil di halaman booking publik
  durationMin Int
  price       Int
  priceFrom   Boolean  @default(false) // true = harga ditampilkan "Mulai Rp…", nominal akhir diatur di Kasir
  // false = disembunyikan dari booking baru (publik & manual), riwayat booking
  // lama tetap utuh. Layanan yang sudah pernah dipakai nggak bisa dihapus,
  // jadi ini jalan keluarnya.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  bookings     Booking[]
  packageItems PackageItem[]

  @@index([outletId])
}

// Satu paket bisa berisi beberapa layanan (mis. potong rambut + warnain
// rambut). Satu "sesi" paket = semua layanan di paket itu dikerjakan
// sekaligus dalam satu kunjungan, jadi counter sesi di CustomerPackage
// tetap satu angka aja. Daftar layanannya disimpan di PackageItem.
model Package {
  id            String @id @default(cuid())
  outletId      String
  name          String // contoh: "Paket 5x Facial"
  totalSessions Int
  price         Int

  items            PackageItem[]
  customerPackages CustomerPackage[]

  @@index([outletId])
}

model PackageItem {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([packageId, serviceId])
  @@index([serviceId])
}

model CustomerPackage {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  packageId    String
  package      Package   @relation(fields: [packageId], references: [id])
  usedSessions Int       @default(0)
  purchasedAt  DateTime  @default(now())
  expiresAt    DateTime?

  transactions  Transaction[]
  sessionUsages PackageSessionUsage[]

  @@index([customerId])
  @@index([packageId])
}

model Booking {
  id         String   @id @default(cuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     String   @default("pending") // pending, confirmed, completed, cancelled, no_show
  notes      String? // catatan untuk kunjungan ini (beda dari Customer.notes yang berlaku terus)
  createdAt  DateTime @default(now())

  transactions        Transaction[]
  notifications       NotificationLog[]
  packageSessionUsage PackageSessionUsage?

  @@index([outletId])
  @@index([staffId, startTime])
}

// Jejak tiap kali satu sesi CustomerPackage terpakai. Dibuat otomatis lewat
// dua jalan: (1) staff pilih "Bayar pakai sesi paket" di Kasir buat suatu
// booking — bookingId keisi, jadi ada jejak sesi ini dipakai buat kunjungan
// yang mana; atau (2) tombol "Pakai sesi" manual di menu Paket, buat
// kunjungan yang nggak dicatat sebagai Booking formal — bookingId null.
// usedSessions di CustomerPackage tetap disimpan sebagai counter cepat
// (dipakai buat validasi "sisa sesi"), dijaga tetap sinkron sama baris di
// sini lewat kode API (app/api/customer-packages/[id] &
// app/api/bookings/[id]/use-package-session), bukan di level schema.
// Catatan: data usedSessions yang sudah ada SEBELUM tabel ini dibikin
// nggak akan punya baris pasangannya di sini — itu wajar, bukan bug.
model PackageSessionUsage {
  id                String          @id @default(cuid())
  customerPackageId String
  customerPackage   CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  bookingId         String?         @unique
  booking           Booking?        @relation(fields: [bookingId], references: [id])
  usedAt            DateTime        @default(now())

  @@index([customerPackageId])
}

// Satu Transaction adalah SATU catatan uang masuk, dan selalu nempel ke
// TEPAT SATU sumber: booking (bayar per kunjungan di Kasir) ATAU
// customerPackage (bayar paket di muka waktu dijual di menu Paket) — nggak
// pernah dua-duanya, nggak pernah kosong dua-duanya. Konsistensi ini dijaga
// di kode API (app/api/transactions & app/api/customer-packages), bukan di
// level schema. onDelete Cascade di customerPackageId sengaja: kalau owner
// hapus CustomerPackage buat koreksi salah input, catatan pendapatannya ikut
// kehapus juga (bukan RESTRICT kayak booking, yang emang jarang dihapus).
model Transaction {
  id                 String           @id @default(cuid())
  bookingId          String?
  booking            Booking?         @relation(fields: [bookingId], references: [id])
  customerPackageId  String?
  customerPackage    CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  amount             Int
  method             String // cash, qris, transfer
  status             String    @default("unpaid") // unpaid, paid
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([bookingId])
  @@index([customerPackageId])
}

model Subscription {
  id              String    @id @default(cuid())
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  planName        String // free, pro
  status          String // active, past_due, cancelled
  gatewayRef      String? // reference id dari Midtrans/Xendit
  nextBillingDate DateTime?
  createdAt       DateTime  @default(now())

  @@index([outletId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  type      String // reminder_h1, confirmation, follow_up
  status    String // sent, failed
  sentAt    DateTime @default(now())

  @@index([bookingId])
}
