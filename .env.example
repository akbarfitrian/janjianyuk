# Database (Supabase Postgres)
# DATABASE_URL = pooled connection (lewat pgbouncer, port 6543) buat runtime app
# DIRECT_URL   = direct connection (port 5432) buat `prisma migrate`
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth (Google OAuth) — dari dashboard Supabase, Project Settings
# → API. NEXT_PUBLIC_* aman diekspos ke browser: anon key cuma bisa dipakai
# buat auth (login/logout), semua akses data bisnis tetap lewat Prisma di
# server, bukan lewat Supabase client.
#
# Sebelum dipakai, aktifin Google provider di dashboard Supabase:
# Authentication → Providers → Google → isi Client ID & Client Secret dari
# Google Cloud Console (OAuth consent screen + OAuth client ID, tipe "Web
# application"). Authorized redirect URI di Google Cloud Console diisi
# dengan: https://[PROJECT-REF].supabase.co/auth/v1/callback
#
# Di Supabase: Authentication → URL Configuration, tambahin
# http://localhost:3000/auth/callback (dev) dan
# https://<domain-production>/auth/callback (prod) ke Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# WA Gateway (Fase 2) — Fonnte atau Wablas
WA_GATEWAY_PROVIDER="fonnte"
WA_GATEWAY_TOKEN=""
# Cuma dipakai kalau WA_GATEWAY_PROVIDER="wablas" — domain Wablas beda-beda
# per akun (mis. https://sby.wablas.com), jadi wajib diisi manual.
WA_GATEWAY_BASE_URL=""

# Payment gateway (Fase 4) — Midtrans atau Xendit, buat billing langganan outlet
PAYMENT_GATEWAY_PROVIDER="xendit"
# Midtrans: isi Server Key. Xendit: isi Secret Key. Dua-duanya dari dashboard
# masing-masing gateway (mode sandbox/test dulu buat development).
PAYMENT_GATEWAY_SECRET_KEY=""
# "true" buat mode production (Midtrans) — default sandbox/test kalau kosong.
PAYMENT_GATEWAY_IS_PRODUCTION="false"
# Xendit doang: "Verification Token" dari Xendit Dashboard → Settings →
# Webhooks, dipakai buat validasi header x-callback-token di webhook.
# Midtrans nggak butuh ini — dia diverifikasi pakai signature SHA512 dari
# PAYMENT_GATEWAY_SECRET_KEY di atas.
PAYMENT_GATEWAY_CALLBACK_TOKEN=""

# Base URL app ini (dipakai buat nyusun URL redirect balik setelah bayar,
# fallback kalau header Origin nggak ada). Di lokal biarin default, di
# Vercel isi dengan domain production, mis. https://janjianyuk.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret buat validasi request dari Vercel Cron ke /api/cron/reminder
CRON_SECRET=""
